<Project>
  <Import Project="$(RedBoltRoot)/src/Directory.Build.targets" />
  <!-- Tests use editor types directly. Their output bucket is separate, so copy the editor
       assembly and include it in the test host dependency graph. -->
  <ItemGroup>
    <ProjectReference Update="$(RedBoltRoot)/src/RedBolt/Editor/RedBolt.Editor.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>
  <!--
    Import every module's test integration so the test suite can exercise all modules. Each module's
    TestIntegration.targets registers itself (with its native flag) and is guarded internally so the
    shared logic is only imported once.
  -->
  <Import Project="$(RedBolt2DRoot)/src/RedBolt.2D.TestIntegration.targets" />
  <Import Project="$(RedBoltPhysicsBox2DRoot)/src/RedBolt.PhysicsBox2D.TestIntegration.targets" />
  <Import Project="$(RedBoltCSGRoot)/src/RedBolt.CSG.TestIntegration.targets" />
  <Import Project="$(RedBoltPhysicsJoltRoot)/src/RedBolt.PhysicsJolt.TestIntegration.targets" />
  <Import Project="$(RedBoltActionsRoot)/src/RedBolt.Actions.TestIntegration.targets" />
  <Import Project="$(RedBoltParticlesRoot)/src/RedBolt.Particles.TestIntegration.targets" />
  <Import Project="$(RedBoltNavigationRoot)/src/RedBolt.Navigation.TestIntegration.targets" />
  <Import Project="$(RedBoltNetworkRoot)/src/RedBolt.Network.TestIntegration.targets" />
  <Import Project="$(RedBoltRmlUIRoot)/src/RedBolt.RmlUI.TestIntegration.targets" />
  <Import Project="$(RedBoltIKRoot)/src/RedBolt.IK.TestIntegration.targets" />
  <Import Project="$(RedBoltGlowRoot)/src/RedBolt.Glow.TestIntegration.targets" />
  <Import Project="$(RedBoltXRRoot)/src/RedBolt.XR.TestIntegration.targets" />

  <!-- Test projects probe every shared output bucket so they can run against the built modules. -->
  <ItemGroup Condition="('$(RedBoltPlatform)' == 'linux-x64' or '$(RedBoltPlatform)' == 'win-x64') and '$(IsTestProject)' == 'true'">
    <AdditionalProbingPath Remove="@(AdditionalProbingPath)" />
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/$(RedBoltPlatform)/core" />
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/$(RedBoltPlatform)/extern" />
    <AdditionalProbingPath Include="$(RedBoltCoreOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltExternOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltToolsOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltHostExternOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltHostToolsOutputDir)" />
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/host/extern" />
    <AdditionalProbingPath Include="$(RedBoltBuildRoot)/bin/$(Configuration)/host/tools" />
  </ItemGroup>

  <!--
    Standalone layout (no monorepo root): core projects referenced from the tests evaluate on their own and
    would default to the core's build/. Pass this project's build root down every ProjectReference that leaves
    this repository, in the resolved reference set, and in the restore graph, so the whole graph shares one
    build root. References inside this repository already share the root; extra global properties would build
    them a second time. The monorepo needs none of this: its root Directory.Build.props selects the same root
    everywhere.
  -->
  <PropertyGroup Condition="'$(RedBoltMonorepoRoot)' == ''">
    <_RedBoltStandaloneRepositoryPrefix>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))'))</_RedBoltStandaloneRepositoryPrefix>
  </PropertyGroup>
  <ItemGroup Condition="'$(RedBoltMonorepoRoot)' == ''">
    <ProjectReference Update="@(ProjectReference)">
      <AdditionalProperties Condition="!$([System.String]::Copy('%(FullPath)').StartsWith('$(_RedBoltStandaloneRepositoryPrefix)'))">%(ProjectReference.AdditionalProperties);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <Target Name="RedBoltConfigureStandaloneProjectReferences"
          AfterTargets="_SplitProjectReferencesByFileExistence"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties;ResolveProjectReferences"
          Condition="'$(RedBoltMonorepoRoot)' == ''">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Update="@(_MSBuildProjectReferenceExistent)">
        <SetConfiguration Condition="!$([System.String]::Copy('%(FullPath)').StartsWith('$(_RedBoltStandaloneRepositoryPrefix)'))">%(_MSBuildProjectReferenceExistent.SetConfiguration);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot)</SetConfiguration>
      </_MSBuildProjectReferenceExistent>
    </ItemGroup>
  </Target>
  <Target Name="RedBoltConfigureStandaloneRestoreGraph"
          BeforeTargets="_FilterRestoreGraphProjectInputItems;_GenerateRestoreProjectPathWalk;_GenerateRestoreProjectPathItemsPerFramework;_GenerateProjectRestoreGraphPerFramework"
          Condition="'$(RedBoltMonorepoRoot)' == ''">
    <PropertyGroup>
      <_GenerateRestoreGraphProjectEntryInputProperties>$(_GenerateRestoreGraphProjectEntryInputProperties);RedBoltBuildRoot=$(RedBoltBuildRoot);RedBoltExpectedBuildRoot=$(RedBoltExpectedBuildRoot)</_GenerateRestoreGraphProjectEntryInputProperties>
    </PropertyGroup>
  </Target>
</Project>
