<Project>
  <PropertyGroup>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt'))</RedBoltRoot>
    <RedBolt2DRoot Condition="'$(RedBolt2DRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.2D'))</RedBolt2DRoot>
    <RedBoltPhysicsBox2DRoot Condition="'$(RedBoltPhysicsBox2DRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.PhysicsBox2D'))</RedBoltPhysicsBox2DRoot>
    <RedBoltCSGRoot Condition="'$(RedBoltCSGRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.CSG'))</RedBoltCSGRoot>
    <RedBoltPhysicsJoltRoot Condition="'$(RedBoltPhysicsJoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.PhysicsJolt'))</RedBoltPhysicsJoltRoot>
    <RedBoltActionsRoot Condition="'$(RedBoltActionsRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.Actions'))</RedBoltActionsRoot>
    <RedBoltParticlesRoot Condition="'$(RedBoltParticlesRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.Particles'))</RedBoltParticlesRoot>
    <RedBoltNavigationRoot Condition="'$(RedBoltNavigationRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.Navigation'))</RedBoltNavigationRoot>
    <RedBoltNetworkRoot Condition="'$(RedBoltNetworkRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.Network'))</RedBoltNetworkRoot>
    <RedBoltRmlUIRoot Condition="'$(RedBoltRmlUIRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.RmlUI'))</RedBoltRmlUIRoot>
    <RedBoltIKRoot Condition="'$(RedBoltIKRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.IK'))</RedBoltIKRoot>
    <RedBoltGlowRoot Condition="'$(RedBoltGlowRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt.Glow'))</RedBoltGlowRoot>
  </PropertyGroup>

  <Import Project="$(RedBoltRoot)/src/Directory.Build.props" />

  <PropertyGroup>
    <RedBoltIsSampleProject>false</RedBoltIsSampleProject>
    <RedBoltArtifactCategory>tests</RedBoltArtifactCategory>
    <RedBoltArtifactPivots>$(Configuration.ToLowerInvariant())-$(TargetFramework.ToLowerInvariant())</RedBoltArtifactPivots>
    <RedBoltOutputDir>$(RedBoltOutputRoot)/tests</RedBoltOutputDir>
    <OutputPath>$(RedBoltOutputDir)/</OutputPath>
    <RuntimeIdentifier Condition="'$(RedBoltPlatform)' == 'linux-x64'">linux-x64</RuntimeIdentifier>
    <ArtifactsProjectName>$(RedBoltArtifactCategory)</ArtifactsProjectName>
    <ArtifactsPivots>$(RedBoltArtifactPivots)</ArtifactsPivots>
    <BaseOutputPath>$(RedBoltBuildRoot)/$(RedBoltArtifactCategory)-</BaseOutputPath>
    <PublishDir>$(RedBoltBuildRoot)/publish-$(RedBoltArtifactCategory)-$(RedBoltArtifactPivots)/</PublishDir>
    <BaseIntermediateOutputPath>$(RedBoltBuildRoot)/obj/$(RedBoltArtifactCategory)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
