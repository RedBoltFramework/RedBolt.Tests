<Project>
  <PropertyGroup>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../RedBolt'))</RedBoltRoot>
  </PropertyGroup>

  <Import Project="$(RedBoltRoot)/src/Directory.Build.props" />

  <PropertyGroup>
    <RedBoltIsSampleProject>false</RedBoltIsSampleProject>
    <RedBoltArtifactCategory>tests</RedBoltArtifactCategory>
    <RedBoltArtifactPivots>$(Configuration.ToLowerInvariant())-$(TargetFramework.ToLowerInvariant())</RedBoltArtifactPivots>
    <RedBoltOutputDir>$(RedBoltOutputRoot)/tests</RedBoltOutputDir>
    <OutputPath>$(RedBoltOutputDir)/</OutputPath>
    <RuntimeIdentifier Condition="'$(RedBoltPlatform)' == 'linux-x64'">linux-x64</RuntimeIdentifier>
    <ArtifactsProjectName>$(RedBoltArtifactCategory)</ArtifactsProjectName>
    <ArtifactsPivots>$(RedBoltArtifactPivots)</ArtifactsPivots>
    <BaseOutputPath>$(RedBoltBuildRoot)/$(RedBoltArtifactCategory)-</BaseOutputPath>
    <PublishDir>$(RedBoltBuildRoot)/publish-$(RedBoltArtifactCategory)-$(RedBoltArtifactPivots)/</PublishDir>
    <BaseIntermediateOutputPath>$(RedBoltBuildRoot)/obj/$(RedBoltArtifactCategory)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
